        "posthog-js",
        "posthog-node",
        "posthog-python",
        "posthog-ios",
        "posthog-android",
        "posthog\\.init\\(",
        "new PostHog\\(",
        "import posthog"
      ],
      "hosts": [
        "posthog.com"
      ],
      "keywords": [
        "posthog"
      ]
    },
